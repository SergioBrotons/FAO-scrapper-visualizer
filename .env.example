# ==============================================================================
# CYTRIA INTELLIGENCE PLATFORM — ENV CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier vers .env : cp .env.example .env
# 2. Renseignez votre clé API MiniMax ci-dessous.
# 3. Pour un déploiement Vercel : ajoutez ces variables dans :
#    Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================================

# --- MiniMax LLM Configuration (Planifié pour MiniMax M3 / M2.7) ---
# Clé API MiniMax (obtenue sur https://platform.minimax.io ou votre portail MiniMax)
MINIMAX_API_KEY=votre_cle_api_minimax_ici

# URL de l'API MiniMax (Supporte à la fois l'endpoint natif et le protocole Anthropic compatible)
# Format natif standard : https://api.minimax.io/v1
# Format compatible Anthropic/Claude : https://api.minimax.io/anthropic
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Modèle cible (MiniMax-M3 ou MiniMax-M2.7)
MINIMAX_MODEL=MiniMax-M3

# Température de génération (0.1 - 0.2 recommandé pour l'exactitude notariée/chiffrée)
AI_TEMPERATURE=0.15

# --- Localisation & Règles Français Suisse (Genève) ---
DEFAULT_LOCALE=fr-CH
DEFAULT_CURRENCY=CHF
CANTON=GE

# --- Serveur & Base de Données ---
PORT=8088
DB_PATH=./data/state/state.sqlite

# --- Sources Officielles Genève ---
FAO_BASE_URL=https://fao.ge.ch
SITG_REST_URL=https://vector.sitg.ge.ch/arcgis/rest/services
BROWSER_PROFILE_DIR=./data/browser_profile
HEADLESS=true
